# Optional Antigravity CLI overrides:
# ANTIGRAVITY_CLI_PATH=/Users/you/.local/bin/agy
# ANTIGRAVITY_CLI_MODEL=Gemini 3.5 Flash (Medium)
# ANTIGRAVITY_CLI_PRINT_TIMEOUT=5m

# Optional Toss Securities Open API read-only connector:
# TOSSINVEST_CLIENT_ID=c_...
# TOSSINVEST_CLIENT_SECRET=s_...
# TOSSINVEST_BASE_URL=https://openapi.tossinvest.com
# Optional read-only bridge to a pb-daily-market-brief workspace.
# PB_DAILY_INTELLIGENCE_DIR=C:\path\to\pb-daily-market-brief\workspace
# Optional approved job runner for the same PB pipeline.
# PB_DAILY_INTELLIGENCE_ENGINE_DIR=C:\path\to\pb-daily-market-brief
# PB_DAILY_INTELLIGENCE_PYTHON=C:\path\to\python.exe
# Run report jobs in GitHub Actions with repository Secrets, then sync the artifact locally.
# PB_DAILY_INTELLIGENCE_REMOTE_ENABLED=true
# PB_DAILY_INTELLIGENCE_REMOTE_REPO=owner/pb-daily-market-brief
# PB_DAILY_INTELLIGENCE_REMOTE_WORKFLOW=daily-brief.yml
# PB_DAILY_INTELLIGENCE_REMOTE_REF=main
# PB_DAILY_INTELLIGENCE_GH=C:\Program Files\GitHub CLI\gh.exe

# Optional SEC EDGAR Form 13F collector identity. SEC asks automated clients
# to identify the application and a monitored contact email.
# SEC_13F_USER_AGENT=FinanceAgentGUI research your-email@example.com
