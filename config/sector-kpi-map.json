  },
  "default": {
    "operatingKpis": [
      {"id": "revenue_growth_yoy", "unit": "percent", "sourceTypes": ["sec_filing", "issuer_ir"]},
      {"id": "gross_margin", "unit": "percent", "sourceTypes": ["sec_filing", "sec_xbrl"]},
      {"id": "operating_margin", "unit": "percent", "sourceTypes": ["sec_filing", "sec_xbrl"]},
      {"id": "free_cash_flow_margin", "unit": "percent", "sourceTypes": ["sec_filing", "sec_xbrl"]}
