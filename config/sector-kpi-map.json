    "valuationMetrics": [
      {"id": "fcf_yield", "unit": "percent", "priority": 1},
      {"id": "ev_ebitda", "unit": "multiple", "priority": 2},
      {"id": "pe", "unit": "multiple", "priority": 3}
    ]
  },
