{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "articleId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "deck": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": ["시장", "금융", "경제", "산업", "테크", "정치", "AI", "기후", "크립토"]
      }
    },
    "articleMarkdown": {
      "type": "string"
    },
    "eventSignature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "object": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time": {
          "type": "string"
        },
        "marketMechanism": {
          "type": "string"
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["actor", "action", "object", "time", "marketMechanism", "sourceIds"]
    },
    "editorialReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicationReady": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["blocking", "advisory"]
              },
              "code": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "suggestedFix": {
                "type": "string"
              }
            },
            "required": ["severity", "code", "location", "rationale", "suggestedFix"]
          }
        }
      },
      "required": ["publicationReady", "summary", "issues"]
    }
  },
  "required": [
    "articleId",
    "title",
    "deck",
    "summary",
    "topics",
    "articleMarkdown",
    "eventSignature",
    "editorialReview"
  ]
}
