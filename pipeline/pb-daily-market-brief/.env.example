# SEC requires an identifying User-Agent. Use your own name and email address.
SEC_USER_AGENT=Your Name your.email@example.com

# A private parent page in Notion. The script creates one child page per brief.
NOTION_PARENT_PAGE_ID=
# Optional separate parent for operator-confirmed V2 preview pages. When blank,
# the V2 publisher uses NOTION_PARENT_PAGE_ID but still creates a new page with
# a [V2 TEST] title and never replaces an existing page.
NOTION_V2_TEST_PARENT_PAGE_ID=

# Keep this secret only in .env. Never paste it into a chat, document, or git repository.
NOTION_TOKEN=

# SEC request guardrail (SEC Fair Access guidance caps users at 10 requests per second).
SEC_REQUEST_DELAY_SECONDS=0.25
SEC_LOOKBACK_DAYS=14

# Optional source adapters. Leave a key blank to skip that source cleanly.
# OpenAI is used only when the next AI-summary step is enabled.
OPENAI_API_KEY=
OPENAI_ITEM_MODEL=gpt-5-mini
OPENAI_BRIEF_MODEL=gpt-5-mini
OPENAI_BRIEF_MAX_OUTPUT_TOKENS=5600
OPENAI_ANALYSIS_MODEL=gpt-5-mini
# Optional override for notable US company 10-Q/10-K summaries.
OPENAI_COMPANY_FILING_MODEL=gpt-5-mini
FRED_API_KEY=
# Preferred current official KRW/USD reference rate source.
BOK_ECOS_API_KEY=
# Official Korea Exchange index APIs. The key and separate KOSPI/KOSDAQ
# daily-index service approvals are both required.
KRX_OPEN_API_KEY=
# Licensed KIS market snapshots for KOSPI cash and KOSPI 200 futures
# foreign-investor net buying. Keep these private and do not expose raw data
# to third parties outside the KIS market-data terms.
KIS_APP_KEY=
KIS_APP_SECRET=
ALPHAVANTAGE_API_KEY=
# Total shared request ceiling for every Alpha Vantage stage in one daily run.
# Keep 25 for the documented free profile. Set 0 only for an account whose
# agreement has no daily request ceiling.
ALPHAVANTAGE_DAILY_REQUEST_LIMIT=25
# Supplemental daily-market requests after the existing ten-ETF dashboard.
# Seven requests prioritize current SEC-event stocks, RSP/MDY breadth, and
# missing sector ETFs. Set this lower if other jobs share a free account.
US_MARKET_DATA_REQUEST_BUDGET=7
US_MARKET_DATA_MAX_EVENT_SECURITIES=2
SECTOR_FUNDAMENTAL_REQUEST_BUDGET=8
# Broad, keyword-led international news discovery. Keep the original publisher link.
NEWSAPI_KEY=
# Official Korean disclosure metadata from Financial Supervisory Service OpenDART.
OPENDART_API_KEY=
OPENDART_LOOKBACK_DAYS=3
X_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# Optional private Google Drive broker-research inbox. The OAuth user must have
# access only to the intended folder. Every report requires a matching
# `<report>.meta.json` rights sidecar.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_RESEARCH_FOLDER_ID=
GOOGLE_DRIVE_RESEARCH_MAX_FILES=100

# Optional local or Google Drive Desktop-synced folder. When blank, the default
# remains workspace/incoming_reports/.
BROKER_REPORT_INBOX_DIR=

# Notion data-source ID for the private qualitative-research inbox.
# Create it once with setup_qualitative_inbox.py, then store the ID here or as a GitHub Secret.
QUALITATIVE_INBOX_DATA_SOURCE_ID=

# The daily brief's reporting timezone.
BRIEF_TIMEZONE=Asia/Seoul
